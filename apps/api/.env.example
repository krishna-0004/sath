# Node runtime environment (development | test | production)
NODE_ENV=development

# HTTP server port
PORT=4000

# Pino logging level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# MongoDB connection URI (Atlas SRV or local MongoDB)
MONGODB_URI=mongodb://localhost:27017/saath

# Client origin allowlist for CORS (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5173

# Internal URL of the Python AI service
AI_SERVICE_URL=http://localhost:8000

# Shared authentication Bearer token for AI microservice (minimum 32 characters)
AI_SERVICE_TOKEN=local-dev-service-token-at-least-32-chars-long

# --- Phase 1 Authentication ---
# Google OAuth 2.0 Web Client credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# OAuth Callback URL (must match Authorized Redirect URI in Google Cloud Console)
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# JWT Access Token secret key (min 32 characters; used for signing 15-min access tokens)
JWT_ACCESS_SECRET=min-32-char-jwt-access-secret-for-saath-platform-change-me

# Cookie encryption/signing secret (min 32 characters; MUST be different from JWT_ACCESS_SECRET)
COOKIE_SECRET=min-32-char-cookie-secret-different-from-jwt-secret-change-me

# Access token TTL in seconds (default 900 = 15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token TTL in days (default 7 = 7 days)
REFRESH_TOKEN_TTL_DAYS=7

# Refresh token race condition leeway window in seconds (default 10)
REFRESH_REUSE_LEEWAY_SECONDS=10

# Demo user login toggle (true = allows POST /api/auth/demo, false = 404 NOT_FOUND)
DEMO_LOGIN_ENABLED=false

# --- Later Phase Placeholders ---
# Cloudinary Private Assets Storage (Phase 2)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Google Workspace / Gmail REST API (Phase 3)
# GMAIL_CLIENT_EMAIL=
# GMAIL_PRIVATE_KEY=

# ElevenLabs Voice Synthesis (Phase 3)
# ELEVENLABS_API_KEY=

# Scheduled Cron Ingress Secret (Phase 4)
# TICK_SECRET=min-32-char-webhook-tick-secret-for-cron-triggers
